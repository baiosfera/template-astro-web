---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteName = process.env.PROJECT_NAME || "Web Platform";
---

<BaseLayout title={`Checkout — ${siteName}`}>
  <div class="max-w-3xl mx-auto px-6 py-16 font-sans" id="checkoutApp">
    <a href="/" class="text-xs text-neutral-500 hover:text-neutral-300 font-mono mb-8 inline-block">← Volver al inicio</a>

    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight text-white">Checkout Multi-Pasarela</h1>
      <p class="text-neutral-400 text-sm mt-2">
        Plantilla agnóstica lista para hidratar con los productos, tarifas y pasarelas de la marca activa.
      </p>
    </header>

    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 space-y-6 shadow-xl">
      <div class="flex justify-between items-center border-b border-neutral-800 pb-4">
        <div>
          <h2 class="text-base font-bold text-white">Orden de Servicio / Producto Digital</h2>
          <p class="text-xs text-neutral-400 mt-1">Configuración dinámica de monto y pasarela.</p>
        </div>
        <span class="text-sm font-mono text-indigo-300">/api/v1/payments/create-session</span>
      </div>

      <form id="checkoutForm" class="space-y-6">
        <div>
          <label for="baseAmount" class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-1">
            Monto (USD):
          </label>
          <input
            type="number"
            id="baseAmount"
            name="baseAmount"
            min="1"
            value="9"
            step="1"
            required
            class="w-full bg-neutral-950 border border-neutral-800 rounded-lg px-4 py-2.5 text-sm text-white font-bold focus:outline-none focus:border-indigo-500"
          />
        </div>

        <div>
          <span class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-2">
            Pasarelas Activas en Entorno:
          </span>
          <div id="gatewaysContainer" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-neutral-400">
            Consultando /api/v1/payments/gateways...
          </div>
        </div>

        <div id="paymentFeedback" class="hidden text-xs p-3 rounded-lg"></div>

        <button
          type="submit"
          id="payButton"
          class="w-full py-3.5 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-500 font-bold text-sm text-white transition-colors cursor-pointer disabled:opacity-50"
        >
          Continuar al Pago
        </button>
      </form>
    </div>
  </div>

  <script>
    interface GatewayInfo {
      id: string;
      name: string;
      currencies: string[];
      supportedMethods: string[];
    }

    let selectedGateway = "dlocalgo";
    const gatewaysContainer = document.getElementById("gatewaysContainer") as HTMLElement;
    const checkoutForm = document.getElementById("checkoutForm") as HTMLFormElement;
    const baseAmountInput = document.getElementById("baseAmount") as HTMLInputElement;
    const feedback = document.getElementById("paymentFeedback") as HTMLElement;

    async function loadGateways(): Promise<void> {
      try {
        const res = await fetch("/api/v1/payments/gateways");
        if (!res.ok) throw new Error("Failed loading gateways");
        const data = (await res.json()) as { gateways: GatewayInfo[]; defaultGateway?: string };
        if (!data.gateways || data.gateways.length === 0) {
          gatewaysContainer.innerHTML = '<div class="col-span-3 p-4 rounded-xl border border-neutral-800 bg-neutral-950">Sin pasarelas configuradas en el entorno.</div>';
          return;
        }
        selectedGateway = data.defaultGateway || data.gateways[0].id;
        gatewaysContainer.innerHTML = data.gateways.map((gw) => `
          <label class="cursor-pointer border rounded-xl p-3 flex flex-col justify-between ${gw.id === selectedGateway ? "border-indigo-500 bg-indigo-950/30" : "border-neutral-800 bg-neutral-950"}">
            <div class="flex items-center justify-between">
              <span class="font-bold text-white">${gw.name}</span>
              <input type="radio" name="gatewayRadio" value="${gw.id}" ${gw.id === selectedGateway ? "checked" : ""} />
            </div>
            <span class="text-[10px] text-neutral-400 mt-1 font-mono">${gw.supportedMethods.join(", ")}</span>
          </label>
        `).join("");

        gatewaysContainer.querySelectorAll<HTMLInputElement>("input[name='gatewayRadio']").forEach((el) => {
          el.addEventListener("change", (ev) => {
            selectedGateway = (ev.target as HTMLInputElement).value;
          });
        });
      } catch (err) {
        gatewaysContainer.textContent = err instanceof Error ? err.message : "Error cargando pasarelas";
      }
    }

    checkoutForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      feedback.className = "block bg-neutral-950 border border-neutral-800 text-neutral-300 text-xs p-3 rounded-lg";
      feedback.textContent = `Sesión lista para ${selectedGateway} por $${baseAmountInput.value} USD.`;
    });

    loadGateways();
  </script>
</BaseLayout>
