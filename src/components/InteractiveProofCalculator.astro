---
import type { InteractiveProofSpec } from "@astrobranding/contracts";

interface Props {
  spec: InteractiveProofSpec;
  ctaHref: string;
  ctaLabel: string;
}

const { spec, ctaHref, ctaLabel } = Astro.props;
const shouldRender = spec.mechanism !== "none";
const rootId = `proof-${spec.formula_profile}-${Math.random().toString(36).slice(2, 8)}`;
---

{shouldRender && (
  <section
    id={rootId}
    data-proof-calculator
    data-formula-profile={spec.formula_profile}
    class="rounded-2xl border border-neutral-800 bg-[var(--brand-surface,#121215)] p-6 sm:p-8 shadow-xl"
  >
    <div class="mb-6">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--brand-text-primary,#f5f5f5)]">
        {spec.title}
      </h2>
      {spec.subtitle && (
        <p class="mt-2 text-sm text-neutral-400 leading-relaxed">{spec.subtitle}</p>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-7 space-y-5">
        {spec.inputs.map((inp) => (
          <div class="space-y-2">
            {inp.type === "toggle" ? (
              <label class="flex items-center gap-3 cursor-pointer text-sm font-medium text-neutral-200">
                <input
                  type="checkbox"
                  data-proof-input={inp.id}
                  checked={Boolean(inp.default_value)}
                  class="h-4 w-4 accent-[var(--brand-primary,#6366f1)]"
                />
                <span>{inp.label}</span>
              </label>
            ) : (
              <>
                <div class="flex items-center justify-between gap-2 text-sm">
                  <label for={`${rootId}-${inp.id}`} class="font-medium text-neutral-200">
                    {inp.label}
                  </label>
                  {inp.type === "range" && (
                    <span class="font-mono tabular-nums text-xs text-neutral-300" data-proof-mirror={inp.id}>
                      {String(inp.default_value ?? inp.min_val ?? 0)} {inp.unit ?? ""}
                    </span>
                  )}
                </div>

                {inp.type === "range" && (
                  <input
                    id={`${rootId}-${inp.id}`}
                    type="range"
                    data-proof-input={inp.id}
                    min={inp.min_val ?? 1}
                    max={inp.max_val ?? 100}
                    step={inp.step ?? 1}
                    value={String(inp.default_value ?? inp.min_val ?? 1)}
                    class="w-full accent-[var(--brand-primary,#6366f1)]"
                  />
                )}

                {inp.type === "number" && (
                  <input
                    id={`${rootId}-${inp.id}`}
                    type="number"
                    data-proof-input={inp.id}
                    min={inp.min_val ?? 0}
                    max={inp.max_val ?? undefined}
                    step={inp.step ?? 1}
                    value={String(inp.default_value ?? 0)}
                    class="w-full rounded-lg border border-neutral-700 bg-neutral-950/70 px-3 py-2 text-sm font-mono tabular-nums text-white"
                  />
                )}

                {inp.type === "select" && (
                  <select
                    id={`${rootId}-${inp.id}`}
                    data-proof-input={inp.id}
                    class="w-full rounded-lg border border-neutral-700 bg-neutral-950/70 px-3 py-2 text-sm text-white"
                  >
                    {inp.options.map((opt) => (
                      <option value={opt.value} selected={opt.value === String(inp.default_value ?? "")}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                )}
              </>
            )}
          </div>
        ))}
      </div>

      <div class="lg:col-span-5 space-y-3 rounded-xl border border-neutral-800 bg-neutral-950/60 p-5">
        {spec.outputs.map((out) => (
          <div
            class:list={[
              "rounded-lg p-3 border",
              out.emphasis === "primary"
                ? "border-[var(--brand-primary,#6366f1)]/60 bg-[var(--brand-primary,#6366f1)]/10"
                : "border-neutral-800 bg-neutral-900/50",
            ]}
          >
            <div class="text-xs text-neutral-400">{out.label}</div>
            <div
              class="mt-1 text-xl font-bold font-mono tabular-nums text-[var(--brand-text-primary,#ffffff)]"
              data-proof-output={out.formula_key}
              data-proof-format={out.format}
            >
              --
            </div>
          </div>
        ))}

        <a
          href={spec.post_submit_route || ctaHref}
          data-preserve-utms
          class="mt-4 inline-flex w-full items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition-opacity hover:opacity-90 bg-[var(--brand-primary,#6366f1)] text-[var(--brand-on-primary,#ffffff)]"
        >
          {ctaLabel}
        </a>
      </div>
    </div>

    <script is:inline define:vars={{ rootId }}>
      (() => {
        const root = document.getElementById(rootId);
        if (!root) return;
        const profile = root.dataset.formulaProfile || "none";
        const inputs = Array.from(root.querySelectorAll("[data-proof-input]"));
        const outputs = Array.from(root.querySelectorAll("[data-proof-output]"));

        const readValues = () => {
          const vals = {};
          for (const el of inputs) {
            const key = el.dataset.proofInput;
            if (!key) continue;
            if (el.type === "checkbox") vals[key] = el.checked;
            else if (el.type === "range" || el.type === "number") vals[key] = Number(el.value || 0);
            else vals[key] = el.value;
            const mirror = root.querySelector(`[data-proof-mirror="${key}"]`);
            if (mirror) mirror.textContent = String(el.value);
          }
          return vals;
        };

        const compute = (vals) => {
          if (profile === "freedom_leverage_v1") {
            const profit = Math.max(0, Number(vals.net_monthly_profit || 12000000));
            const hours = Math.max(1, Number(vals.weekly_hours || 40));
            const hourly = Math.round(profit / (hours * 4.33));
            const ceiling = Math.round(profit * 12);
            const share = vals.business_model === "products" ? 0.32 : 0.38;
            const reclaimed = Math.round(hours * share * 50);
            const oppCost = Math.round(reclaimed * hourly);
            const projected = Math.round(ceiling * 1.45 + oppCost * 0.5);
            const payrollOn = Boolean(vals.compare_payroll_toggle);
            const payrollRoles = payrollOn ? Math.max(1, Number(vals.payroll_roles || 1)) : 0;
            const payrollUnit = Number(vals.payroll_monthly_cost || 2909290);
            return {
              real_hourly_rate: hourly,
              current_annual_ceiling: ceiling,
              annual_hours_reclaimed: reclaimed,
              opportunity_cost_annual: oppCost,
              leveraged_projection_annual: projected,
              annual_payroll_saved: payrollOn ? Math.round(payrollRoles * payrollUnit * 12) : 0,
            };
          }
          if (profile === "roi_cost_gap_v1") {
            const mc = Math.max(0, Number(vals.monthly_operating_cost || 5000000));
            const rc = Math.max(1, Number(vals.roles_count || 1));
            const wh = Math.max(0, Number(vals.weekly_hours_lost || 15));
            const hv = Math.max(0, Number(vals.hourly_value || 80000));
            const ms = Math.round(mc * rc * 0.65);
            return {
              monthly_savings: ms,
              annual_savings: ms * 12 + Math.round(wh * 50 * hv),
              annual_hours_reclaimed: Math.round(wh * 50),
            };
          }
          return {};
        };

        const fmt = (val, kind) => {
          if (val === undefined || val === null) return "--";
          const n = Number(val);
          if (!Number.isFinite(n)) return String(val);
          if (kind === "currency") return `$${n.toLocaleString("es-CO")}`;
          if (kind === "hours") return `${n.toLocaleString("es-CO")} h`;
          if (kind === "percent") return `${n}%`;
          return n.toLocaleString("es-CO");
        };

        const render = () => {
          const res = compute(readValues());
          for (const out of outputs) {
            const key = out.dataset.proofOutput;
            const kind = out.dataset.proofFormat || "number";
            out.textContent = fmt(res[key], kind);
          }
        };

        for (const el of inputs) {
          el.addEventListener("input", render);
          el.addEventListener("change", render);
        }
        render();
      })();
    </script>
  </section>
)}
